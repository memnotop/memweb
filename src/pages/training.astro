---
import PageLayout from '@/layouts/BaseLayout.astro'
import { loadTrainingRecords } from '@/utils/training'
import {
  createTrainingCalendar,
  getDateInTimeZone,
  TRAINING_LEVEL_LABELS,
  TRAINING_TIME_ZONE
} from '@/utils/training-calendar'

import '@/assets/styles/training.css'

const trainingRecords = await loadTrainingRecords()
const calendar = createTrainingCalendar(trainingRecords, getDateInTimeZone(TRAINING_TIME_ZONE))
const selectedRecord = trainingRecords.find((record) => record.date === calendar.selectedKey)
const trainingJson = JSON.stringify(
  trainingRecords.map(({ date, title, level, items, rpe, htmlBody }) => ({
    date,
    title,
    level,
    items,
    rpe,
    htmlBody
  }))
).replace(/</g, '\\u003c')
const initialStatus = selectedRecord
  ? `Selected ${selectedRecord.date}: ${selectedRecord.title}`
  : `Selected ${calendar.selectedKey}: no entry`
---

<PageLayout meta={{ title: 'Training' }} highlightColor='#8fcf91'>
  <main class='training-page animate' id='content'>
    <div class='training-board' id='training-board'>
      <div class='training-summary'>
        <div>
          <p class='training-eyebrow'>Training Log</p>
          <h1>Training Log</h1>
          <p>Add dated entries to a yearly `Training.md` file to populate this calendar.</p>
        </div>
        <div class='training-legend' aria-label='Training intensity scale'>
          <span>Light</span>
          <i class='training-cell level-1'></i>
          <i class='training-cell level-2'></i>
          <i class='training-cell level-3'></i>
          <i class='training-cell level-4'></i>
          <i class='training-cell level-5'></i>
          <span>Hard</span>
        </div>
      </div>

      <div class='training-heatmap' aria-label='Training date selector'>
        <p class='sr-only' id='training-keyboard-help'>
          Use the arrow keys to move between dates. Home and End move to the start or end of the
          week.
        </p>
        <div class='training-chart-wrap'>
          <div
            class='training-months'
            id='training-months'
            style={`--training-weeks: ${calendar.weekCount}`}
          >
            {
              calendar.months.map((month) => (
                <span style={`grid-column: ${month.week + 1} / span 1`}>{month.label}</span>
              ))
            }
          </div>
          <div class='training-chart'>
            <div class='training-weekdays' aria-hidden='true'>
              <span></span>
              <span>Mon</span>
              <span></span>
              <span>Wed</span>
              <span></span>
              <span>Fri</span>
              <span></span>
            </div>
            <div
              class='training-grid'
              id='training-grid'
              role='radiogroup'
              aria-label='Training dates from the past year'
              aria-describedby='training-keyboard-help'
              aria-controls='training-detail'
              style={`--training-weeks: ${calendar.weekCount}`}
            >
              {
                calendar.days.map((day) => {
                  const isSelected = day.date === calendar.selectedKey

                  return (
                    <button
                      class:list={[
                        'training-day',
                        `level-${day.level}`,
                        { future: day.isFuture, active: isSelected }
                      ]}
                      type='button'
                      data-day={day.date}
                      disabled={day.isFuture}
                      tabindex={isSelected ? 0 : -1}
                      role='radio'
                      aria-checked={isSelected ? 'true' : 'false'}
                      aria-current={day.date === calendar.todayKey ? 'date' : undefined}
                      aria-label={`${day.date} ${day.label}`}
                      title={`${day.date} ${day.label}`}
                    />
                  )
                })
              }
            </div>
          </div>
        </div>
      </div>

      <p class='sr-only' id='training-status' role='status' aria-live='polite' aria-atomic='true'>
        {initialStatus}
      </p>

      <div class='training-detail' id='training-detail' role='region' aria-label='Training details'>
        {
          selectedRecord ? (
            <article class='training-entry active'>
              <div class='training-entry-head'>
                <span>{selectedRecord.date}</span>
                <strong class={`level-text level-${selectedRecord.level}`}>
                  {selectedRecord.level} - {TRAINING_LEVEL_LABELS[selectedRecord.level]}
                </strong>
              </div>
              <h2>{selectedRecord.title}</h2>
              {selectedRecord.items.length > 0 && (
                <ul>
                  {selectedRecord.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              {selectedRecord.rpe && <p class='training-rpe'>RPE: {selectedRecord.rpe}</p>}
              {selectedRecord.htmlBody && (
                <div class='training-body' set:html={selectedRecord.htmlBody} />
              )}
            </article>
          ) : (
            <article class='training-entry active'>
              <div class='training-entry-head'>
                <span>{calendar.selectedKey}</span>
                <strong class='level-text level-0'>No entry</strong>
              </div>
              <h2>No entry for this date</h2>
              <p>Add a dated training entry to see it here.</p>
            </article>
          )
        }
      </div>
    </div>
  </main>

  <Fragment slot='body-end'>
    <script id='training-data' type='application/json' is:inline set:html={trainingJson} />
    <script>
      import { initTrainingPage } from '@/scripts/training'

      initTrainingPage()
    </script>
  </Fragment>
</PageLayout>
